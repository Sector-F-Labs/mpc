# Environment configuration for Man Page Compiler
# Use with direnv: https://direnv.net/

# Add local bin directory to PATH
export PATH="$(pwd)/bin:$PATH"

# Add LLVM tools to PATH
if [ -d "/opt/homebrew/Cellar/llvm" ]; then
    # macOS Homebrew LLVM (versioned)
    LLVM_PATH=$(ls -d /opt/homebrew/Cellar/llvm/*/bin | head -1)
    export PATH="$LLVM_PATH:$PATH"
    export LLVM_CONFIG="$LLVM_PATH/llvm-config"
    export LLVM_LLC_PATH="$LLVM_PATH/llc"
    export LLVM_CLANG_PATH="$LLVM_PATH/clang"
elif [ -d "/opt/homebrew/bin" ] && [ -f "/opt/homebrew/bin/llc" ]; then
    # macOS Homebrew LLVM (linked)
    export PATH="/opt/homebrew/bin:$PATH"
    export LLVM_CONFIG="/opt/homebrew/bin/llvm-config"
    export LLVM_LLC_PATH="/opt/homebrew/bin/llc"
    export LLVM_CLANG_PATH="/opt/homebrew/bin/clang"
elif [ -d "/usr/bin" ] && command -v llc >/dev/null 2>&1; then
    # System LLVM (Linux)
    export LLVM_CONFIG="llvm-config"
    export LLVM_LLC_PATH="$(which llc)"
    export LLVM_CLANG_PATH="$(which clang)"
else
    echo "Warning: LLVM tools not found. Install with:"
    echo "  macOS: brew install llvm"
    echo "  Ubuntu: apt install llvm-dev"
fi

# Set build directory
export MPC_BUILD_DIR="$(pwd)/src/build"

# Ollama configuration
export OLLAMA_HOST="http://localhost:11434"
export OLLAMA_MODEL="gemma4"

# Development flags
export MPC_DEBUG=1
export MPC_VERBOSE=1

echo "✓ MPC environment loaded"
echo "  LLVM: $(which llc 2>/dev/null || echo 'not found')"
echo "  Build dir: $MPC_BUILD_DIR"
echo "  Ollama: $OLLAMA_HOST"
echo "  MPC: $(which mpc 2>/dev/null || echo 'run make to build')"
